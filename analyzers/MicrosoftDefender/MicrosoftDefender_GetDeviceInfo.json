{
    "name": "MicrosoftDefender_GetDeviceInfo",
    "version": "1.0",
    "author": "CySOC",
    "url": "https://github.com/TheHive-Project/Cortex-Analyzers",
    "license": "AGPL-V3",
    "description": "Get device information from Microsoft Defender for Endpoint (MDE) by hostname, FQDN, or IP address. Returns risk level, exposure, OS, AV status, scan times, and more.",
    "dataTypeList": ["hostname", "fqdn", "ip"],
    "command": "MicrosoftDefender/MicrosoftDefender.py",
    "baseConfig": "MicrosoftDefender",
    "config": {
        "check_tlp": false,
        "max_tlp": 3
    },
    "configurationItems": [
        {
            "name": "tenant_id",
            "description": "Azure AD Tenant ID",
            "type": "string",
            "multi": false,
            "required": true,
            "defaultValue": ""
        },
        {
            "name": "client_id",
            "description": "Azure AD Application (Client) ID — requires WindowsDefenderATP Machine.Read.All permission",
            "type": "string",
            "multi": false,
            "required": true,
            "defaultValue": ""
        },
        {
            "name": "client_secret",
            "description": "Azure AD Application Client Secret",
            "type": "string",
            "multi": false,
            "required": true,
            "defaultValue": ""
        }
    ],
    "registration_required": true,
    "subscription_required": true,
    "free_subscription": false,
    "service_homepage": "https://security.microsoft.com"
}
